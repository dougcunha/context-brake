node_modules/
dist/
coverage/
*.tsbuildinfo

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# Local link to .agents for Claude Code (see README, Contributing). No trailing slash, so a symlink is ignored too.
/.claude

# Agent transient runtime lock files
.agents/*.lock

# Claude Code local settings, reached through the /.claude link (status line bridge, automatic restart)
.agents/settings.local.json

# ContextBrake's own installation in this repository (written by `context-brake init`, regenerable): never versioned
/context-brake.config.json
/.context-brake/
/.agents/hooks/context-brake*.mjs
/.agents/settings.json

