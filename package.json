{
  "name": "context-brake",
  "version": "1.0.0",
  "description": "Context telemetry and an advisory brake for coding-agent harnesses",
  "type": "module",
  "bin": {
    "context-brake": "dist/src/cli/main.js"
  },
  "files": [
    "dist",
    "schemas",
    "docs/telemetry-block.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "install:check": "npm install --ignore-scripts",
    "build": "npm run schemas:generate && npm run assets:build && tsc -p tsconfig.json",
    "assets:build": "tsx scripts/build-assets.ts",
    "assets:check": "tsx scripts/check-assets.ts",
    "schemas:generate": "tsx scripts/generate-schemas.ts",
    "schemas:check": "tsx scripts/check-schemas.ts",
    "dependencies:check": "tsx scripts/check-install-scripts.ts",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:bench": "vitest run --config vitest.bench.config.ts",
    "test:budget": "tsx scripts/check-test-budget.ts",
    "package:smoke": "npm run assets:check && tsx scripts/check-package.ts && node dist/src/cli/main.js",
    "release:verify-tag": "tsx scripts/check-release-tag.ts",
    "release:check": "npm run schemas:check && npm run dependencies:check && npm run build && npm run typecheck && npm run lint && npm run coverage && npm run test:bench && npm run test:budget && npm run package:smoke"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "jsonc-parser": "^3.3.1",
    "semver": "^7.8.5",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^20.19.43",
    "@types/semver": "^7.8.0",
    "@vitest/coverage-v8": "^3.2.4",
    "esbuild": "^0.25.12",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "js-tiktoken": "^1.0.21",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
