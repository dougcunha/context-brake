{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "activeHarnesses": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "claude-code",
          "codex-cli",
          "cursor",
          "github-copilot-cli",
          "opencode",
          "pi",
          "oh-my-pi",
          "antigravity-cli"
        ]
      }
    },
    "excludedHarnesses": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "claude-code",
          "codex-cli",
          "cursor",
          "github-copilot-cli",
          "opencode",
          "pi",
          "oh-my-pi",
          "antigravity-cli"
        ]
      }
    },
    "telemetry": {
      "type": "object",
      "properties": {
        "injectionMode": {
          "type": "string",
          "enum": [
            "threshold_only",
            "always"
          ]
        },
        "activationThresholdPercentage": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "contextWindowCeiling": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "declaredContextWindow": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "turnCeiling": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "zones": {
          "type": "object",
          "properties": {
            "greenMaxPercentage": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "yellowMaxPercentage": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "criticalPercentage": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "greenMaxTurn": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "yellowMaxTurn": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "criticalTurn": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "greenMaxPercentage",
            "yellowMaxPercentage",
            "criticalPercentage"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "injectionMode",
        "activationThresholdPercentage",
        "contextWindowCeiling",
        "zones"
      ],
      "additionalProperties": false
    },
    "snapshot": {
      "default": {
        "triggerZone": "RED"
      },
      "type": "object",
      "properties": {
        "triggerZone": {
          "default": "RED",
          "type": "string",
          "enum": [
            "YELLOW",
            "RED"
          ]
        },
        "command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "resumeCommand": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "additionalProperties": false
    },
    "debug": {
      "type": "boolean"
    },
    "autoRestart": {
      "type": "object",
      "properties": {
        "maxConsecutiveRestarts": {
          "default": 2,
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "activeHarnesses",
    "telemetry"
  ],
  "additionalProperties": false
}
