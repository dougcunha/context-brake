{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "command": {
      "type": "string",
      "const": "doctor"
    },
    "status": {
      "type": "string",
      "enum": [
        "healthy",
        "warnings",
        "errors"
      ]
    },
    "exitCode": {
      "anyOf": [
        {
          "type": "number",
          "const": 0
        },
        {
          "type": "number",
          "const": 1
        },
        {
          "type": "number",
          "const": 2
        }
      ]
    },
    "detections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "harness": {
            "type": "string",
            "enum": [
              "claude-code",
              "codex-cli",
              "cursor",
              "github-copilot-cli",
              "opencode",
              "pi",
              "oh-my-pi",
              "antigravity-cli"
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "project",
              "candidate",
              "excluded"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "origin": {
                  "type": "string",
                  "enum": [
                    "project",
                    "machine"
                  ]
                },
                "kind": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                }
              },
              "required": [
                "origin",
                "kind",
                "value"
              ],
              "additionalProperties": false
            }
          },
          "selectedExplicitly": {
            "type": "boolean"
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          },
          "versionSource": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "executable",
                  "config"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "harness",
          "state",
          "evidence",
          "selectedExplicitly",
          "version",
          "versionSource"
        ],
        "additionalProperties": false
      }
    },
    "integrations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "harness": {
            "type": "string",
            "enum": [
              "claude-code",
              "codex-cli",
              "cursor",
              "github-copilot-cli",
              "opencode",
              "pi",
              "oh-my-pi",
              "antigravity-cli"
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "installed",
              "missing",
              "broken"
            ]
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          },
          "support": {
            "type": "object",
            "properties": {
              "harness": {
                "type": "string",
                "enum": [
                  "claude-code",
                  "codex-cli",
                  "cursor",
                  "github-copilot-cli",
                  "opencode",
                  "pi",
                  "oh-my-pi",
                  "antigravity-cli"
                ]
              },
              "supportLevel": {
                "type": "string",
                "enum": [
                  "full",
                  "partial",
                  "cooperative"
                ]
              },
              "minimumVersion": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "capabilities": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "enum": [
                        "pre_tool_block",
                        "tool_coverage",
                        "post_tool_telemetry",
                        "session_boot",
                        "context_usage",
                        "timeout_fail_closed"
                      ]
                    },
                    "state": {
                      "type": "string",
                      "enum": [
                        "supported",
                        "unsupported",
                        "unknown"
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "state"
                  ],
                  "additionalProperties": false
                }
              },
              "limitations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "capability": {
                      "type": "string",
                      "enum": [
                        "pre_tool_block",
                        "tool_coverage",
                        "post_tool_telemetry",
                        "session_boot",
                        "context_usage",
                        "timeout_fail_closed"
                      ]
                    },
                    "impact": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "capability",
                    "impact"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "harness",
              "supportLevel",
              "minimumVersion",
              "capabilities",
              "limitations"
            ],
            "additionalProperties": false
          },
          "overhead": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "harness": {
                    "type": "string",
                    "enum": [
                      "claude-code",
                      "codex-cli",
                      "cursor",
                      "github-copilot-cli",
                      "opencode",
                      "pi",
                      "oh-my-pi",
                      "antigravity-cli"
                    ]
                  },
                  "executionModel": {
                    "type": "string",
                    "enum": [
                      "process",
                      "in_process"
                    ]
                  },
                  "sampleCount": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "p95Milliseconds": {
                    "anyOf": [
                      {
                        "type": "number",
                        "minimum": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "targetMilliseconds": {
                    "anyOf": [
                      {
                        "type": "number",
                        "const": 100
                      },
                      {
                        "type": "number",
                        "const": 15
                      }
                    ]
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "pass",
                      "fail",
                      "unavailable"
                    ]
                  }
                },
                "required": [
                  "harness",
                  "executionModel",
                  "sampleCount",
                  "p95Milliseconds",
                  "targetMilliseconds",
                  "status"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "harness",
          "state",
          "version",
          "support",
          "overhead"
        ],
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z0-9_]+$"
          },
          "severity": {
            "type": "string",
            "enum": [
              "ok",
              "warning",
              "error"
            ]
          },
          "scope": {
            "type": "string",
            "enum": [
              "project",
              "harness",
              "file",
              "performance"
            ]
          },
          "harness": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "claude-code",
                  "codex-cli",
                  "cursor",
                  "github-copilot-cli",
                  "opencode",
                  "pi",
                  "oh-my-pi",
                  "antigravity-cli"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "path": {
            "type": [
              "string",
              "null"
            ]
          },
          "message": {
            "type": "string"
          },
          "impact": {
            "type": [
              "string",
              "null"
            ]
          },
          "remediation": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "code",
          "severity",
          "scope",
          "harness",
          "path",
          "message",
          "impact",
          "remediation"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "command",
    "status",
    "exitCode",
    "detections",
    "integrations",
    "findings"
  ],
  "additionalProperties": false
}
