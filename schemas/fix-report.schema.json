{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "command": {
      "type": "string",
      "const": "fix"
    },
    "mode": {
      "type": "string",
      "enum": [
        "dry_run",
        "applied"
      ]
    },
    "stopped": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "not_installed",
            "nothing_to_fix"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "healthy",
        "warnings",
        "errors"
      ]
    },
    "exitCode": {
      "anyOf": [
        {
          "type": "number",
          "const": 0
        },
        {
          "type": "number",
          "const": 1
        },
        {
          "type": "number",
          "const": 2
        }
      ]
    },
    "plan": {
      "type": "object",
      "properties": {
        "changes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "create",
                  "update",
                  "delete"
                ]
              },
              "owner": {
                "type": "string",
                "enum": [
                  "config",
                  "harness_entry",
                  "runtime_asset",
                  "manifest",
                  "runtime_state",
                  "gitignore"
                ]
              },
              "summary": {
                "type": "string"
              }
            },
            "required": [
              "path",
              "kind",
              "owner",
              "summary"
            ],
            "additionalProperties": false
          }
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "code": {
                "type": "string",
                "pattern": "^[A-Z0-9_]+$"
              },
              "detail": {
                "type": "string"
              }
            },
            "required": [
              "path",
              "code",
              "detail"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "changes",
        "conflicts"
      ],
      "additionalProperties": false
    },
    "outcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z0-9_]+$"
          },
          "harness": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "claude-code",
                  "codex-cli",
                  "cursor",
                  "github-copilot-cli",
                  "opencode",
                  "pi",
                  "oh-my-pi",
                  "antigravity-cli"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "path": {
            "type": [
              "string",
              "null"
            ]
          },
          "group": {
            "type": "string",
            "enum": [
              "automatic",
              "decision",
              "manual"
            ]
          },
          "outcome": {
            "type": "string",
            "enum": [
              "fixed",
              "skipped",
              "manual",
              "failed",
              "planned"
            ]
          },
          "detail": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "code",
          "harness",
          "path",
          "group",
          "outcome",
          "detail"
        ],
        "additionalProperties": false
      }
    },
    "doctor": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "command": {
          "type": "string",
          "const": "doctor"
        },
        "status": {
          "type": "string",
          "enum": [
            "healthy",
            "warnings",
            "errors"
          ]
        },
        "exitCode": {
          "anyOf": [
            {
              "type": "number",
              "const": 0
            },
            {
              "type": "number",
              "const": 1
            },
            {
              "type": "number",
              "const": 2
            }
          ]
        },
        "detections": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "harness": {
                "type": "string",
                "enum": [
                  "claude-code",
                  "codex-cli",
                  "cursor",
                  "github-copilot-cli",
                  "opencode",
                  "pi",
                  "oh-my-pi",
                  "antigravity-cli"
                ]
              },
              "state": {
                "type": "string",
                "enum": [
                  "project",
                  "candidate",
                  "excluded"
                ]
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "origin": {
                      "type": "string",
                      "enum": [
                        "project",
                        "machine"
                      ]
                    },
                    "kind": {
                      "type": "string"
                    },
                    "value": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "origin",
                    "kind",
                    "value"
                  ],
                  "additionalProperties": false
                }
              },
              "selectedExplicitly": {
                "type": "boolean"
              },
              "version": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "versionSource": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "executable",
                      "config"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "harness",
              "state",
              "evidence",
              "selectedExplicitly",
              "version",
              "versionSource"
            ],
            "additionalProperties": false
          }
        },
        "integrations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "harness": {
                "type": "string",
                "enum": [
                  "claude-code",
                  "codex-cli",
                  "cursor",
                  "github-copilot-cli",
                  "opencode",
                  "pi",
                  "oh-my-pi",
                  "antigravity-cli"
                ]
              },
              "state": {
                "type": "string",
                "enum": [
                  "installed",
                  "missing",
                  "broken"
                ]
              },
              "version": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "support": {
                "type": "object",
                "properties": {
                  "harness": {
                    "type": "string",
                    "enum": [
                      "claude-code",
                      "codex-cli",
                      "cursor",
                      "github-copilot-cli",
                      "opencode",
                      "pi",
                      "oh-my-pi",
                      "antigravity-cli"
                    ]
                  },
                  "supportLevel": {
                    "type": "string",
                    "enum": [
                      "full",
                      "partial"
                    ]
                  },
                  "minimumVersion": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "capabilities": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "enum": [
                            "post_tool_telemetry",
                            "session_boot",
                            "context_usage",
                            "auto_restart"
                          ]
                        },
                        "state": {
                          "type": "string",
                          "enum": [
                            "supported",
                            "unsupported",
                            "unknown"
                          ]
                        }
                      },
                      "required": [
                        "id",
                        "state"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "limitations": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "capability": {
                          "type": "string",
                          "enum": [
                            "post_tool_telemetry",
                            "session_boot",
                            "context_usage",
                            "auto_restart"
                          ]
                        },
                        "impact": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "capability",
                        "impact"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "harness",
                  "supportLevel",
                  "minimumVersion",
                  "capabilities",
                  "limitations"
                ],
                "additionalProperties": false
              },
              "overhead": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "harness": {
                        "type": "string",
                        "enum": [
                          "claude-code",
                          "codex-cli",
                          "cursor",
                          "github-copilot-cli",
                          "opencode",
                          "pi",
                          "oh-my-pi",
                          "antigravity-cli"
                        ]
                      },
                      "executionModel": {
                        "type": "string",
                        "enum": [
                          "process",
                          "in_process"
                        ]
                      },
                      "sampleCount": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "p95Milliseconds": {
                        "anyOf": [
                          {
                            "type": "number",
                            "minimum": 0
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "targetMilliseconds": {
                        "anyOf": [
                          {
                            "type": "number",
                            "const": 100
                          },
                          {
                            "type": "number",
                            "const": 15
                          }
                        ]
                      },
                      "status": {
                        "type": "string",
                        "enum": [
                          "pass",
                          "fail",
                          "unavailable"
                        ]
                      }
                    },
                    "required": [
                      "harness",
                      "executionModel",
                      "sampleCount",
                      "p95Milliseconds",
                      "targetMilliseconds",
                      "status"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "harness",
              "state",
              "version",
              "support",
              "overhead"
            ],
            "additionalProperties": false
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "pattern": "^[A-Z0-9_]+$"
              },
              "severity": {
                "type": "string",
                "enum": [
                  "ok",
                  "warning",
                  "error"
                ]
              },
              "scope": {
                "type": "string",
                "enum": [
                  "project",
                  "harness",
                  "file",
                  "performance"
                ]
              },
              "harness": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "claude-code",
                      "codex-cli",
                      "cursor",
                      "github-copilot-cli",
                      "opencode",
                      "pi",
                      "oh-my-pi",
                      "antigravity-cli"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "path": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "message": {
                "type": "string"
              },
              "impact": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "remediation": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "fix": {
                "type": "object",
                "properties": {
                  "group": {
                    "type": "string",
                    "enum": [
                      "automatic",
                      "decision",
                      "manual"
                    ]
                  }
                },
                "required": [
                  "group"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "code",
              "severity",
              "scope",
              "harness",
              "path",
              "message",
              "impact",
              "remediation"
            ],
            "additionalProperties": false
          }
        },
        "snapshot": {
          "type": "object",
          "properties": {
            "triggerZone": {
              "type": "string",
              "enum": [
                "YELLOW",
                "RED"
              ]
            },
            "triggerPercentage": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "command": {
              "type": [
                "string",
                "null"
              ]
            },
            "resumeCommand": {
              "type": [
                "string",
                "null"
              ]
            },
            "invocations": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "harness": {
                    "type": "string",
                    "enum": [
                      "claude-code",
                      "codex-cli",
                      "cursor",
                      "github-copilot-cli",
                      "opencode",
                      "pi",
                      "oh-my-pi",
                      "antigravity-cli"
                    ]
                  },
                  "command": {
                    "type": "string"
                  },
                  "resumeCommand": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "harness",
                  "command",
                  "resumeCommand"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "triggerZone",
            "command",
            "resumeCommand"
          ],
          "additionalProperties": false
        },
        "contextWindow": {
          "type": "object",
          "properties": {
            "bridge": {
              "type": "string",
              "enum": [
                "absent",
                "installed",
                "inactive"
              ]
            },
            "mod": {
              "type": "string",
              "enum": [
                "absent",
                "installed",
                "reporting"
              ]
            },
            "source": {
              "type": "string",
              "enum": [
                "mod",
                "statusline",
                "contextWindowCeiling"
              ]
            },
            "lastWindowTokens": {
              "anyOf": [
                {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "bridge",
            "mod",
            "source",
            "lastWindowTokens"
          ],
          "additionalProperties": false
        },
        "activeSessions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "harness": {
                "type": "string",
                "enum": [
                  "claude-code",
                  "codex-cli",
                  "cursor",
                  "github-copilot-cli",
                  "opencode",
                  "pi",
                  "oh-my-pi",
                  "antigravity-cli"
                ]
              },
              "sessionId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "lastActivityAt": {
                "type": "string"
              },
              "usage": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "percentage": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "usedTokens": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "windowTokens": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991
                      },
                      "zone": {
                        "type": "string",
                        "enum": [
                          "GREEN",
                          "YELLOW",
                          "RED",
                          "CRITICAL"
                        ]
                      },
                      "source": {
                        "type": "string",
                        "enum": [
                          "measured",
                          "estimated"
                        ]
                      },
                      "at": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "percentage",
                      "usedTokens",
                      "windowTokens",
                      "zone",
                      "source",
                      "at"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "harness",
              "sessionId",
              "lastActivityAt",
              "usage"
            ],
            "additionalProperties": false
          }
        },
        "debugMode": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "schemaVersion",
        "command",
        "status",
        "exitCode",
        "detections",
        "integrations",
        "findings"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "command",
    "mode",
    "stopped",
    "status",
    "exitCode",
    "plan",
    "outcomes",
    "doctor"
  ],
  "additionalProperties": false
}
