{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "command": {
      "type": "string",
      "enum": [
        "init",
        "remove"
      ]
    },
    "mode": {
      "type": "string",
      "enum": [
        "dry_run",
        "applied"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "warnings",
        "errors"
      ]
    },
    "exitCode": {
      "anyOf": [
        {
          "type": "number",
          "const": 0
        },
        {
          "type": "number",
          "const": 1
        },
        {
          "type": "number",
          "const": 2
        }
      ]
    },
    "detections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "harness": {
            "type": "string",
            "enum": [
              "claude-code",
              "codex-cli",
              "cursor",
              "github-copilot-cli",
              "opencode",
              "pi",
              "oh-my-pi",
              "antigravity-cli"
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "project",
              "candidate",
              "excluded"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "origin": {
                  "type": "string",
                  "enum": [
                    "project",
                    "machine"
                  ]
                },
                "kind": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                }
              },
              "required": [
                "origin",
                "kind",
                "value"
              ],
              "additionalProperties": false
            }
          },
          "selectedExplicitly": {
            "type": "boolean"
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          },
          "versionSource": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "executable",
                  "config"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "harness",
          "state",
          "evidence",
          "selectedExplicitly",
          "version",
          "versionSource"
        ],
        "additionalProperties": false
      }
    },
    "plan": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "projectRoot": {
          "type": "string"
        },
        "changes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "realPath": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "create",
                  "update",
                  "delete"
                ]
              },
              "owner": {
                "type": "string",
                "enum": [
                  "config",
                  "protocol",
                  "instruction_block",
                  "harness_entry",
                  "runtime_asset",
                  "manifest"
                ]
              },
              "beforeSha256": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "afterSha256": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "preview": {
                "type": "object",
                "properties": {
                  "summary": {
                    "type": "string"
                  },
                  "startLine": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "endLine": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "snippet": {
                    "type": "string"
                  }
                },
                "required": [
                  "summary"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "path",
              "realPath",
              "kind",
              "owner",
              "beforeSha256",
              "afterSha256",
              "preview"
            ],
            "additionalProperties": false
          }
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "code": {
                "type": "string",
                "pattern": "^[A-Z0-9_]+$"
              },
              "detail": {
                "type": "string"
              }
            },
            "required": [
              "path",
              "code",
              "detail"
            ],
            "additionalProperties": false
          }
        },
        "harnesses": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "harness": {
                "type": "string",
                "enum": [
                  "claude-code",
                  "codex-cli",
                  "cursor",
                  "github-copilot-cli",
                  "opencode",
                  "pi",
                  "oh-my-pi",
                  "antigravity-cli"
                ]
              },
              "outcome": {
                "type": "string",
                "enum": [
                  "planned",
                  "skipped",
                  "conflict"
                ]
              },
              "supportLevel": {
                "type": "string",
                "enum": [
                  "full",
                  "partial",
                  "cooperative"
                ]
              }
            },
            "required": [
              "harness",
              "outcome",
              "supportLevel"
            ],
            "additionalProperties": false
          }
        },
        "requiresConfirmation": {
          "type": "boolean"
        }
      },
      "required": [
        "schemaVersion",
        "projectRoot",
        "changes",
        "conflicts",
        "harnesses",
        "requiresConfirmation"
      ],
      "additionalProperties": false
    },
    "outcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "planned",
              "applied",
              "unchanged",
              "skipped",
              "failed"
            ]
          },
          "detail": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "path",
          "status",
          "detail"
        ],
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z0-9_]+$"
          },
          "severity": {
            "type": "string",
            "enum": [
              "ok",
              "warning",
              "error"
            ]
          },
          "scope": {
            "type": "string",
            "enum": [
              "project",
              "harness",
              "file",
              "performance"
            ]
          },
          "harness": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "claude-code",
                  "codex-cli",
                  "cursor",
                  "github-copilot-cli",
                  "opencode",
                  "pi",
                  "oh-my-pi",
                  "antigravity-cli"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "path": {
            "type": [
              "string",
              "null"
            ]
          },
          "message": {
            "type": "string"
          },
          "impact": {
            "type": [
              "string",
              "null"
            ]
          },
          "remediation": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "code",
          "severity",
          "scope",
          "harness",
          "path",
          "message",
          "impact",
          "remediation"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "command",
    "mode",
    "status",
    "exitCode",
    "detections",
    "plan",
    "outcomes",
    "findings"
  ],
  "additionalProperties": false
}
