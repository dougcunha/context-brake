{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "node .cursor/hooks/context-brake.mjs preToolUse"
      },
      {
        "command": "echo foreign-cursor",
        "timeout": 5
      }
    ],
    "postToolUse": [
      {
        "command": "node .cursor/hooks/context-brake.mjs postToolUse"
      }
    ],
    "sessionStart": [
      {
        "command": "node .cursor/hooks/context-brake.mjs sessionStart"
      }
    ],
    "preCompact": [
      {
        "command": "node .cursor/hooks/context-brake.mjs preCompact"
      }
    ],
    "beforeShellExecution": [
      {
        "command": "node .cursor/hooks/context-brake.mjs beforeShellExecution"
      }
    ],
    "afterFileEdit": [
      {
        "command": "echo foreign-after-edit"
      }
    ]
  }
}
