{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "git -c \"alias.contextbrake=!node .codex/hooks/context-brake.mjs\" contextbrake PreToolUse"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "echo foreign-guard"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "echo foreign-mixed"
          },
          {
            "type": "command",
            "command": "git -c \"alias.contextbrake=!node .codex/hooks/context-brake.mjs\" contextbrake PreToolUse"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "git -c \"alias.contextbrake=!node .codex/hooks/context-brake.mjs\" contextbrake PostToolUse"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "git -c \"alias.contextbrake=!node .codex/hooks/context-brake.mjs\" contextbrake SessionStart"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "git -c \"alias.contextbrake=!node .codex/hooks/context-brake.mjs\" contextbrake Stop"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "echo foreign-notify"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "git -c \"alias.contextbrake=!node .codex/hooks/context-brake.mjs\" contextbrake PermissionRequest"
          }
        ]
      }
    ]
  }
}
